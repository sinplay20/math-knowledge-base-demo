    },
    {
      "Original": {
        "content": {
          "body": "If $a$ and $b$ are even, then $a+b$ is even.",
          "proof": "By Definition 1.1, there exist $m,n\\in\\mathbb{Z}$ such that $a=2m$ and $b=2n$.\n\nHence $a+b=2(m+n)$. Since $m+n\\in\\mathbb{Z}$, the sum $a+b$ is even.",
          "type": "theorem"
        },
        "indexing": {
          "identifier": "Theorem 1.2",
          "location": {
            "document": "sources/even-integers-demo.pdf",
            "page": "2, 5",
            "section": [
              "Chapter 1. Integers",
              "1.1 Even integers"
            ]
          }
        },
        "relations": [
          {
            "basis": "explicit",
            "explanation": "The proof explicitly invokes Definition 1.1.",
            "target": "3252dd78-11d3-48c3-9bab-5f0afcc6a632",
            "type": "depends_on"
          },
          {
            "basis": "inferred",
            "explanation": "Closure under addition restates the theorem under the given definition. The original does not explicitly assert this equivalence.",
            "target": "a5af50f1-eabb-41bc-bf7b-25ca7ebcdb12",
            "type": "equivalent_to"
          }
        ]
      },
      "id": "6aa3b829-a6dc-4769-86ec-0fe084770034"
    },
    {
      "Original": {
        "content": {
          "body": "Thus the set of even integers is closed under addition.",
          "proof": "",
          "type": "statement"
