    {
      "Original": {
        "content": {
          "body": "An integer $n$ is called even if there exists $k\\in\\mathbb{Z}$ such that $n=2k$.",
          "proof": "",
          "type": "definition"
        },
        "indexing": {
          "identifier": "Definition 1.1",
          "location": {
            "document": "sources/even-integers-demo.pdf",
            "page": "1",
            "section": [
              "Chapter 1. Integers",
              "1.1 Even integers"
            ]
          }
        },
        "relations": []
      },
      "id": "3252dd78-11d3-48c3-9bab-5f0afcc6a632"
    },
    {
      "Original": {
        "content": {
          "body": "Throughout this section, all variables range over the integers.",
          "proof": "",
          "type": "statement"
        },
        "indexing": {
          "identifier": "",
          "location": {
            "document": "sources/even-integers-demo.pdf",
            "page": "1",
            "section": [
              "Chapter 1. Integers",
              "1.1 Even integers"
            ]
